{
  "name": "detailflow",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "billing:setup": "tsx src/server/billing/provision.ts",
    "dev": "prisma generate && next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build && pnpm build:worker",
    "build:worker": "esbuild worker/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/worker.mjs --banner:js='import { createRequire } from \"node:module\"; const require = createRequire(import.meta.url);'",
    "start": "next start",
    "worker": "prisma generate && tsx watch worker/index.ts",
    "worker:start": "node dist/worker.mjs",
    "backup": "tsx scripts/pg-backup.ts",
    "backup:cron": "tsx scripts/pg-backup.ts --cron",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma generate && prisma db seed",
    "lint": "eslint ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1157.0",
    "@aws-sdk/s3-request-presigner": "^3.1157.0",
    "@dnd-kit/core": "^6.3.1",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@react-pdf/renderer": "^4.9.0",
    "@sentry/nextjs": "^11.9.0",
    "@sentry/node": "^11.9.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "better-auth": "1.7.14",
    "bullmq": "^6.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "next": "^15.5.28",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "read-excel-file": "^9.3.13",
    "stripe": "^23.0.1",
    "tailwind-merge": "^3.7.0",
    "xmlbuilder2": "^4.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.28",
    "exceljs": "^4.4.0",
    "jsdom": "^30.1.3",
    "pdfjs-dist": "^6.4.299",
    "prisma": "7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp"
    ]
  }
}
