// Model danych v1 — docs/dokumentacja-wdrozenia.md §9.
// Izolacja: każda tabela operacyjna ma `studioId`. Relacje między tabelami
// operacyjnymi idą po (id, studioId), więc baza sama odrzuca powiązanie
// zlecenia z klientem innego studia. Zapytania studia: `studioDb(studioId)`.
// Kwoty: Decimal(12, 2), PLN. Zmiany schematu tylko migracjami.

generator client {
  provider = "prisma-client"
  output   = "../lib/db/generated"
}

datasource db {
  provider = "postgresql"
}

enum StudioStatus {
  trial
  active
  past_due
  suspended
  canceled
}

enum Plan {
  solo
  studio
  pro
}

enum MembershipRole {
  owner
  manager
  worker
}

enum VehicleSize {
  small
  medium
  suv
}

enum OrderStatus {
  accepted
  in_progress
  ready_for_pickup
  completed
  canceled
}

enum QuoteStatus {
  draft
  sent
  accepted
  rejected
  expired
}

// Stan dokumentu. Płatność to `paidAt`, a obieg KSeF to `ksefStatus`.
enum InvoiceStatus {
  draft
  issued
  canceled
}

enum KsefStatus {
  not_sent
  queued
  processing
  accepted
  rejected
  retrying
}

// Korekta to osobny dokument powiązany z fakturą źródłową (`correctsInvoiceId`).
enum InvoiceKind {
  invoice
  correction
}

// TEST i PROD nigdy nie dzielą numeracji ani liczników.
enum KsefEnv {
  test
  production
}

enum KsefEventKind {
  issued
  validated
  sent
  timeout
  processing
  accepted
  rejected
  retry_scheduled
}

// ─── Platforma (bez studioId) ────────────────────────────────────────────────

model Studio {
  id                   String       @id @default(cuid())
  publicCode           String       @unique // ST-00128
  name                 String
  slug                 String       @unique
  ownerLegalName       String? // sprzedawca na FV, np. „Obsidian Studio Michał Kowalski”
  nip                  String?
  address              String?
  postal               String?
  city                 String?
  district             String?
  phone                String?
  status               StudioStatus @default(trial)
  plan                 Plan         @default(solo)
  trialEndsAt          DateTime?
  // Stripe = abonament Detailflow, nie faktury klientów studia.
  stripeCustomerId     String?      @unique
  stripeSubscriptionId String?      @unique
  ksefEnv              KsefEnv      @default(test)
  ksefTokenEnc         String? // szyfrowane at rest
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  coatingReminders   CoatingReminder[]
  orderCounter       OrderCounter?
  orderEvents        WorkOrderEvent[]
  invitations        Invitation[]
  members            Membership[]
  clients            Client[]
  vehicles           Vehicle[]
  bays               Bay[]
  orders             WorkOrder[]
  quotes             Quote[]
  quoteItems         QuoteItem[]
  invoices           Invoice[]
  invoiceRows        InvoiceItem[]
  invoiceCounters    InvoiceCounter[]
  ksefEvents         KsefEvent[]
  ksefSubmissions    KsefSubmission[]
  portalLinks        PortalLink[]
  quoteDecisionMails QuoteDecisionMail[]
  quoteSendMails     QuoteSendMail[]
  orderPhotos        OrderPhoto[]
  intakeProtocols    IntakeProtocol[]
  intakeDamages      IntakeDamage[]

  @@index([status])
}

// Auth (Better Auth, lib/auth.ts). Hasło Argon2id leży w `Account.password`
// (providerId = "credential"), nie w `User`.
model User {
  id              String           @id @default(cuid())
  email           String           @unique
  name            String
  emailVerified   Boolean          @default(false)
  image           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  memberships     Membership[]
  sessions        Session[]
  accounts        Account[]
  orderPhotos     OrderPhoto[]
  intakeProtocols IntakeProtocol[]
  orderEvents     WorkOrderEvent[]
}

// Sesja studia w Postgres; cookie httpOnly niesie podpisany `token`.
model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  password              String? // Argon2id (PHC)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

// Jednorazowe tokeny: magiczny link (hash) i reset hasła.
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// Idempotencja webhooków Stripe po `event.id`.
model StripeEvent {
  id          String   @id // evt_...
  type        String
  processedAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  studioId  String?
  action    String
  meta      Json
  createdAt DateTime @default(now())

  @@index([studioId, createdAt])
}

// ─── Tenant (studioId obowiązkowy) ───────────────────────────────────────────

model Membership {
  id        String         @id @default(cuid())
  studioId  String
  userId    String
  role      MembershipRole
  createdAt DateTime       @default(now())
  studio    Studio         @relation(fields: [studioId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([studioId, userId])
  @@index([userId])
}

model Client {
  id        String   @id @default(cuid())
  studioId  String
  name      String
  email     String?
  phone     String?
  street    String?
  postal    String?
  city      String?
  nip       String? // nabywca B2B
  isRegular Boolean  @default(false)
  createdAt DateTime @default(now())
  studio    Studio   @relation(fields: [studioId], references: [id], onDelete: Cascade)

  vehicles Vehicle[]
  orders   WorkOrder[]
  quotes   Quote[]

  @@unique([id, studioId])
  @@index([studioId, createdAt])
  @@index([studioId, name])
}

model Vehicle {
  id        String      @id @default(cuid())
  studioId  String
  clientId  String
  make      String
  model     String
  plate     String // unikalność w studiu: ostrzeżenie (src/server/klienci), bez @@unique — duplikaty historyczne z CSV
  year      Int?
  color     String?
  size      VehicleSize @default(medium)
  createdAt DateTime    @default(now())
  studio    Studio      @relation(fields: [studioId], references: [id], onDelete: Cascade)
  client    Client      @relation(fields: [clientId, studioId], references: [id, studioId], onDelete: NoAction)

  orders           WorkOrder[]
  quotes           Quote[]
  coatingReminders CoatingReminder[]

  @@unique([id, studioId])
  @@index([studioId, createdAt])
  @@index([plate])
}

model Bay {
  id       String      @id @default(cuid())
  studioId String
  name     String // Boks 01
  sort     Int
  studio   Studio      @relation(fields: [studioId], references: [id], onDelete: Cascade)
  orders   WorkOrder[]

  @@unique([id, studioId])
  @@unique([studioId, sort])
}

model WorkOrder {
  id            String      @id @default(cuid())
  studioId      String
  number        String // DF-0248
  clientId      String
  vehicleId     String
  bayId         String?
  quoteId       String?
  status        OrderStatus
  service       String // „Korekta + ceramika”
  stage         Int         @default(1) // 1–4 po stronie studia; portal pokazuje 3
  scheduledFrom DateTime
  scheduledTo   DateTime
  dueAt         DateTime? // planowany odbiór
  completedAt   DateTime? // dopiero po tym można wystawić FV
  totalGross    Decimal     @db.Decimal(12, 2)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  studio        Studio      @relation(fields: [studioId], references: [id], onDelete: Cascade)
  client        Client      @relation(fields: [clientId, studioId], references: [id, studioId], onDelete: NoAction)
  vehicle       Vehicle     @relation(fields: [vehicleId, studioId], references: [id, studioId], onDelete: NoAction)
  bay           Bay?        @relation(fields: [bayId, studioId], references: [id, studioId], onDelete: NoAction)
  quote         Quote?      @relation(fields: [quoteId, studioId], references: [id, studioId], onDelete: NoAction)

  invoices    Invoice[]
  portalLinks PortalLink[]
  photos      OrderPhoto[]
  intake      IntakeProtocol?
  events      WorkOrderEvent[]

  @@unique([studioId, number])
  @@unique([id, studioId])
  @@unique([quoteId, studioId])
  @@index([studioId, status])
  @@index([studioId, createdAt])
  @@index([studioId, scheduledFrom])
}

// Ostatni przydzielony numer DF-#### w studiu. Przydział = atomowy increment,
// więc równoległe zlecenia nie dostają tego samego numeru (src/server/zlecenia/state.ts).
model OrderCounter {
  studioId String @id
  last     Int    @default(0)
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
}

// Historia zlecenia (zakładka Historia). Wpis powstaje razem ze zmianą statusu
// lub etapu, w tej samej transakcji. `fromStatus = null` oznacza utworzenie.
model WorkOrderEvent {
  id          String       @id @default(cuid())
  studioId    String
  workOrderId String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  fromStage   Int?
  toStage     Int
  actorId     String?
  createdAt   DateTime     @default(now())
  studio      Studio       @relation(fields: [studioId], references: [id], onDelete: Cascade)
  workOrder   WorkOrder    @relation(fields: [workOrderId, studioId], references: [id, studioId], onDelete: Cascade)
  actor       User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workOrderId, studioId, createdAt])
}

model Quote {
  id         String      @id @default(cuid())
  studioId   String
  clientId   String
  vehicleId  String
  status     QuoteStatus
  sizeMult   Decimal     @db.Decimal(4, 2)
  paintMult  Decimal     @db.Decimal(4, 2)
  totalGross Decimal     @db.Decimal(12, 2)
  vatAmount  Decimal     @db.Decimal(12, 2) // brutto × 23/123
  notes      String?
  sentAt     DateTime?
  decidedAt  DateTime?
  createdAt  DateTime    @default(now())
  studio     Studio      @relation(fields: [studioId], references: [id], onDelete: Cascade)
  client     Client      @relation(fields: [clientId, studioId], references: [id, studioId], onDelete: NoAction)
  vehicle    Vehicle     @relation(fields: [vehicleId, studioId], references: [id, studioId], onDelete: NoAction)

  items        QuoteItem[]
  order        WorkOrder?
  portalLinks  PortalLink[]
  decisionMail QuoteDecisionMail?
  sendMail     QuoteSendMail?

  @@unique([id, studioId])
  @@index([studioId, status])
  @@index([studioId, createdAt])
}

model QuoteItem {
  id          String  @id @default(cuid())
  studioId    String
  quoteId     String
  name        String
  basePrice   Decimal @db.Decimal(12, 2) // brutto przed mnożnikami
  durationMin Int?
  sort        Int
  studio      Studio  @relation(fields: [studioId], references: [id], onDelete: Cascade)
  quote       Quote   @relation(fields: [quoteId, studioId], references: [id, studioId], onDelete: Cascade)

  @@index([studioId, quoteId])
}

// Faktura klienta studia (KSeF FA(3)). To nie jest Stripe Invoice.
model Invoice {
  id                String        @id @default(cuid())
  studioId          String
  number            String // FV/41/10/2026
  workOrderId       String
  status            InvoiceStatus
  kind              InvoiceKind   @default(invoice)
  ksefEnv           KsefEnv
  ksefStatus        KsefStatus    @default(not_sent)
  ksefNumber        String?
  ksefAcceptedAt    DateTime?
  ksefUpoXml        String?
  // Nabywca zapisany w chwili wystawienia; może różnić się od klienta zlecenia.
  buyerName         String
  buyerNip          String?
  buyerStreet       String?
  buyerPostal       String?
  buyerCity         String?
  issuedAt          DateTime?
  saleAt            DateTime?
  dueAt             DateTime?
  paidAt            DateTime? // przelew zaksięgowany ręcznie; brak = nieopłacona
  emailedAt         DateTime? // data wysyłki PDF; kolejna = „Wyślij ponownie”
  totalNet          Decimal       @db.Decimal(12, 2)
  totalVat          Decimal       @db.Decimal(12, 2)
  // Dla korekty kwoty (total*, net/vat/gross pozycji) to różnica względem stanu
  // przed korektą i mogą być ujemne; quantity/unitNet pozycji to stan po korekcie.
  totalGross        Decimal       @db.Decimal(12, 2)
  correctsInvoiceId String?
  correctionReason  String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  studio            Studio        @relation(fields: [studioId], references: [id], onDelete: Cascade)
  workOrder         WorkOrder     @relation(fields: [workOrderId, studioId], references: [id, studioId], onDelete: NoAction)
  correctsInvoice   Invoice?      @relation("InvoiceCorrections", fields: [correctsInvoiceId, studioId], references: [id, studioId], onDelete: NoAction)

  corrections Invoice[]       @relation("InvoiceCorrections")
  items       InvoiceItem[]
  events      KsefEvent[]
  submission  KsefSubmission?

  @@unique([studioId, ksefEnv, number])
  @@unique([ksefEnv, ksefNumber])
  @@unique([id, studioId])
  @@index([studioId, status])
  @@index([studioId, ksefStatus])
  @@index([studioId, createdAt])
  @@index([studioId, correctsInvoiceId])
  @@index([ksefNumber])
}

// Ostatni przydzielony numer dokumentu (FV/41/10/2026): osobno dla studia,
// środowiska KSeF, rodzaju dokumentu i roku. TEST i PROD nie dzielą liczników.
model InvoiceCounter {
  studioId String
  ksefEnv  KsefEnv
  kind     InvoiceKind
  year     Int
  last     Int         @default(0)
  studio   Studio      @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@id([studioId, ksefEnv, kind, year])
}

model InvoiceItem {
  id        String  @id @default(cuid())
  studioId  String
  invoiceId String
  lp        Int
  name      String
  quantity  Decimal @db.Decimal(10, 3)
  unit      String // „usł.”
  unitNet   Decimal @db.Decimal(12, 2)
  vatRate   Int // 23
  net       Decimal @db.Decimal(12, 2)
  vat       Decimal @db.Decimal(12, 2)
  gross     Decimal @db.Decimal(12, 2)
  studio    Studio  @relation(fields: [studioId], references: [id], onDelete: Cascade)
  invoice   Invoice @relation(fields: [invoiceId, studioId], references: [id, studioId], onDelete: Cascade)

  @@unique([invoiceId, lp])
  @@index([studioId, invoiceId])
}

// Historia wysyłki do KSeF (D-09).
model KsefEvent {
  id        String        @id @default(cuid())
  studioId  String
  invoiceId String
  kind      KsefEventKind
  at        DateTime
  attempt   Int?
  ref       String? // referencja sesji KSeF
  message   String
  studio    Studio        @relation(fields: [studioId], references: [id], onDelete: Cascade)
  invoice   Invoice       @relation(fields: [invoiceId, studioId], references: [id, studioId], onDelete: Cascade)

  @@index([studioId, invoiceId, at])
}

// Immutable XML prepared and XSD-validated by the invoice generator (#43).
// Redis contains only IDs. References survive retries and worker restarts.
model KsefSubmission {
  id               String    @id @default(cuid())
  studioId         String
  invoiceId        String    @unique
  xml              String
  xmlHash          String
  sessionReference String?
  invoiceReference String?
  sendStartedAt    DateTime?
  createdAt        DateTime  @default(now())
  studio           Studio    @relation(fields: [studioId], references: [id], onDelete: Cascade)
  invoice          Invoice   @relation(fields: [invoiceId, studioId], references: [id, studioId], onDelete: Cascade)

  @@unique([invoiceId, studioId])
  @@index([studioId, invoiceId])
}

// Portal klienta: w bazie tylko hash, surowy token wyłącznie w URL.
model PortalLink {
  id          String     @id @default(cuid())
  studioId    String
  workOrderId String?
  quoteId     String?
  tokenHash   String     @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime   @default(now())
  studio      Studio     @relation(fields: [studioId], references: [id], onDelete: Cascade)
  workOrder   WorkOrder? @relation(fields: [workOrderId, studioId], references: [id, studioId], onDelete: Cascade)
  quote       Quote?     @relation(fields: [quoteId, studioId], references: [id, studioId], onDelete: Cascade)

  @@index([studioId, workOrderId])
  @@index([studioId, quoteId])
}

// Outbox zapisany atomowo z decyzją. Bez tokenu i URL portalu.
model QuoteDecisionMail {
  id        String    @id @default(cuid())
  studioId  String
  quoteId   String    @unique
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  studio    Studio    @relation(fields: [studioId], references: [id], onDelete: Cascade)
  quote     Quote     @relation(fields: [quoteId, studioId], references: [id, studioId], onDelete: Cascade)

  @@unique([quoteId, studioId])
  @@index([studioId, sentAt])
}

// Zaproszenie jednorazowe; surowy token trafia tylko do e-maila.
model Invitation {
  id         String         @id @default(cuid())
  studioId   String
  email      String
  role       MembershipRole
  tokenHash  String         @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime       @default(now())
  studio     Studio         @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioId, email])
}

// Jawny termin konserwacji; bez zgadywania dat na podstawie nazwy usługi.
model CoatingReminder {
  id          String    @id @default(cuid())
  studioId    String
  vehicleId   String
  dueAt       DateTime
  completedAt DateTime?
  studio      Studio    @relation(fields: [studioId], references: [id], onDelete: Cascade)
  vehicle     Vehicle   @relation(fields: [vehicleId, studioId], references: [id, studioId], onDelete: Cascade)

  @@index([studioId, completedAt, dueAt])
}

// Zdjęcie zlecenia w prywatnym buckecie S3. Klucz: studios/<studioId>/orders/<workOrderId>/<id>.<ext>.
// Wiersz powstaje przy wydaniu presigned URL (`uploadedAt` null) i staje się widoczny po potwierdzeniu uploadu.
model OrderPhoto {
  id           String    @id @default(cuid())
  studioId     String
  workOrderId  String
  no           Int // numer zdjęcia w zleceniu (#12)
  stage        Int // etap studia 1–4 w chwili dodania
  key          String    @unique
  contentType  String
  sizeBytes    Int
  caption      String?
  uploadedById String?
  createdAt    DateTime  @default(now())
  uploadedAt   DateTime?
  studio       Studio    @relation(fields: [studioId], references: [id], onDelete: Cascade)
  workOrder    WorkOrder @relation(fields: [workOrderId, studioId], references: [id, studioId], onDelete: Cascade)
  uploadedBy   User?     @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  damages IntakeDamage[]

  @@unique([id, studioId])
  @@unique([workOrderId, no])
  @@index([studioId, workOrderId, uploadedAt])
}

// Protokół przyjęcia: jeden na zlecenie. Po akceptacji klienta jest niezmienny.
model IntakeProtocol {
  id          String    @id @default(cuid())
  studioId    String
  workOrderId String
  number      String // P-0248
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  acceptedAt  DateTime? // akceptacja klienta; UI portalu później
  studio      Studio    @relation(fields: [studioId], references: [id], onDelete: Cascade)
  workOrder   WorkOrder @relation(fields: [workOrderId, studioId], references: [id, studioId], onDelete: Cascade)
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  damages IntakeDamage[]

  @@unique([workOrderId, studioId])
  @@unique([studioId, number])
  @@unique([id, studioId])
}

// Punkt uszkodzenia 1..n na schemacie auta; posX/posY to ułamki 0–1 szerokości/wysokości schematu.
model IntakeDamage {
  id         String         @id @default(cuid())
  studioId   String
  protocolId String
  photoId    String?
  no         Int
  title      String
  part       String
  size       String?
  posX       Float
  posY       Float
  studio     Studio         @relation(fields: [studioId], references: [id], onDelete: Cascade)
  protocol   IntakeProtocol @relation(fields: [protocolId, studioId], references: [id, studioId], onDelete: Cascade)
  photo      OrderPhoto?    @relation(fields: [photoId, studioId], references: [id, studioId], onDelete: NoAction)

  @@unique([protocolId, no])
  @@index([studioId, protocolId])
}

// Trwały job wysyłki. Token powstaje dopiero w workerze i nigdy nie trafia do outboxa.
model QuoteSendMail {
  id        String    @id @default(cuid())
  studioId  String
  quoteId   String    @unique
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  studio    Studio    @relation(fields: [studioId], references: [id], onDelete: Cascade)
  quote     Quote     @relation(fields: [quoteId, studioId], references: [id, studioId], onDelete: Cascade)

  @@unique([quoteId, studioId])
  @@index([studioId, sentAt])
}
