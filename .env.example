# Skopiuj do .env. Wartości działają z `docker compose up` (hosty = nazwy serwisów).
# Przy `pnpm dev` na hoście zamień postgres/redis/minio/mailpit na localhost.

# Porty na hoście, jeśli domyślne są zajęte (tylko docker compose).
# WEB_PORT=3000
# POSTGRES_PORT=5432

APP_URL=http://localhost:3000

DATABASE_URL=postgresql://detailflow:detailflow@postgres:5432/detailflow
REDIS_URL=redis://redis:6379

S3_ENDPOINT=http://minio:9000
# Adres S3 dla przeglądarki (presigned URL); domyślnie S3_ENDPOINT. Z Compose: localhost.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=detailflow
S3_ACCESS_KEY=detailflow
S3_SECRET_KEY=detailflow-dev-secret

# Wygeneruj własny: openssl rand -base64 32
AUTH_SECRET=dev-only-change-me-0123456789abcdef

# Stripe = abonament Detailflow (tryb testowy).
# Konfiguracja produktów/webhooków/Stripe Tax: src/server/billing/README.md.
# Po ustawieniu klucza: pnpm billing:setup (osobno test i live).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Opcjonalny host API Stripe. Puste zostawia api.stripe.com. E2E podstawia lokalną atrapę.
# STRIPE_API_HOST=
# STRIPE_API_PORT=
# STRIPE_API_PROTOCOL=

# KSeF = faktury klientów studia. Lokalnie zawsze test.
KSEF_ENV=test
KSEF_API_URL=https://api-test.ksef.mf.gov.pl
# Exactly 32 random bytes, base64: openssl rand -base64 32. TEST only.
KSEF_TOKEN_ENCRYPTION_KEY=

# E-mail: lokalnie Mailpit (podgląd http://localhost:8025).
SMTP_URL=smtp://mailpit:1025
RESEND_API_KEY=
EMAIL_FROM=Detailflow <noreply@detailflow.local>

SMSAPI_TOKEN=
# Sentry web + worker. Puste = zdarzenia są odrzucane. Przeglądarka używa osobnej zmiennej publicznej.
SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# Upload source map tylko gdy ustawione są wszystkie trzy: SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT.
# Backup: pg_dump --format=custom do S3 pod prefixem, cron w serwisie Compose `backup` (domyślnie 03:00 UTC, 14 dni).
# BACKUP_RETENTION_DAYS=14
# BACKUP_S3_PREFIX=backups/postgres
# BACKUP_HOUR_UTC=3
